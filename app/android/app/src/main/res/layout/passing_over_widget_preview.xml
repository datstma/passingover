<?xml version="1.0" encoding="utf-8"?>
<!-- Shown in the widget picker: sample content (D40). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_title_preview"
        android:text="SK 945"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:textColor="#80FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_destination_preview"
        android:text="→ Chicago"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-light"
        android:maxLines="1"
        android:textColor="#EBFFFFFF"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/widget_details_preview"
        android:text="15:12 there, 9°C and overcast · landing in about 7 h 40 min"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_updated_preview"
        android:text="As of 21:30"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#5CFFFFFF"
        android:textSize="11sp" />
</LinearLayout>
